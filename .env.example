# Database
DATABASE_URL=postgresql+asyncpg://bridge:bridge@db:5432/bridge
DATABASE_SYNC_URL=postgresql://bridge:bridge@db:5432/bridge

# Auth
JWT_SECRET_KEY=change-me-in-production-use-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider (gemini | mock | adversarial)
AI_PROVIDER=mock
GEMINI_API_KEY=

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/tmp/bridge_uploads

# Postgres (used by docker-compose)
POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge
POSTGRES_DB=bridge
