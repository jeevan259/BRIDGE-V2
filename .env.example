# ==============================================================================
# BRIDGE v2 Environment Configuration
# ==============================================================================

# Database Connectivity
# In Docker: use 'db:5432'; Locally: use 'localhost:5432'
DATABASE_URL=postgresql+asyncpg://bridge:bridge@localhost:5432/bridge
DATABASE_SYNC_URL=postgresql://bridge:bridge@localhost:5432/bridge

# Postgres Container Configuration (used by docker-compose)
POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge
POSTGRES_DB=bridge

# Authentication & Security
# WARNING: Change JWT_SECRET_KEY in production (generate via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change-me-in-production-use-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=bridge-auth
JWT_AUDIENCE=bridge-clients
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session & Cookie Security (Environment-Driven)
# COOKIE_SECURE: true | false (defaults to true in production, false in development)
COOKIE_SECURE=false
# COOKIE_SAMESITE: lax | strict | none (use 'none' with COOKIE_SECURE=true for cross-origin frontend/backend)
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN: optional shared domain for subdomains (e.g., .mybrandbridge.com)
COOKIE_DOMAIN=

# AI Provider Configuration
# Options: 'gemini' (live Google Gemini API), 'mock' (deterministic hash-based), 'adversarial' (citation traps)
AI_PROVIDER=mock
GEMINI_API_KEY=

# Application & Runtime
ENVIRONMENT=development
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=/tmp/bridge_uploads

# Demo & Offline Mode
# Set to 'true' to allow seamless local inspection and testing even without live PostgreSQL
DEMO_MODE=false

# Frontend Configuration (Vite)
# Base URL of the API for production builds or separate host deployments
VITE_API_URL=
# Local frontend dev server port (default: 3000)
VITE_PORT=3000
